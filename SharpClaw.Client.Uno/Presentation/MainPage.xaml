<Page x:Class="SharpClaw.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:SharpClaw.Presentation"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      NavigationCacheMode="Required"
      Background="Black">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="240" />
      <ColumnDefinition Width="1" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Background="#0D0D0D">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="16,18,16,16" Spacing="8">
        <TextBlock Text="SharpClaw"
                   Style="{StaticResource TerminalText}"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#00FF00" />
        <TextBlock Text="direct chat"
                   Style="{StaticResource TerminalText}"
                   FontSize="11"
                   Foreground="#888888" />
        <Border Height="1" Background="#1A1A1A" Margin="0,8,0,8" />
        <TextBlock Text="Each message is independent. The base client keeps no conversation history."
                   Style="{StaticResource TerminalText}"
                   FontSize="10"
                   Foreground="#666666"
                   TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="16,0,16,12" Spacing="6">
        <Border Height="1" Background="#1A1A1A" Margin="0,0,0,4" />
        <Button Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="OnSettingsClick">
          <TextBlock Text="[settings]" Style="{StaticResource TerminalText}"
                     FontSize="12" Foreground="#808080" />
        </Button>
        <Button Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="OnLogoutClick">
          <TextBlock Text="[logout]" Style="{StaticResource TerminalText}"
                     FontSize="12" Foreground="#808080" />
        </Button>
        <Button Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="OnLegalNoticesClick">
          <TextBlock Text="[legal]" Style="{StaticResource TerminalText}"
                     FontSize="12" Foreground="#808080" />
        </Button>
        <Button Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="OnUserGuideClick">
          <TextBlock Text="[guide]" Style="{StaticResource TerminalText}"
                     FontSize="12" Foreground="#808080" />
        </Button>
        <Button Background="Transparent" BorderThickness="0" Padding="0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="OnReportIssueClick">
          <TextBlock Text="[report]" Style="{StaticResource TerminalText}"
                     FontSize="12" Foreground="#808080" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
          <Button Background="Transparent" BorderThickness="0" Padding="4"
                  Click="OnOfficialWebsiteClick"
                  ToolTipService.ToolTip="Official website">
            <TextBlock Text="&#xE774;"
                       FontFamily="{ThemeResource SymbolThemeFontFamily}"
                       FontSize="14" Foreground="#00FF00" />
          </Button>
          <Button Background="Transparent" BorderThickness="0" Padding="4"
                  Click="OnMatrixCommunityClick"
                  ToolTipService.ToolTip="Matrix community">
            <TextBlock Text="M" Style="{StaticResource TerminalText}"
                       FontSize="14" FontWeight="Bold" Foreground="#00FF00" />
          </Button>
          <Button Background="Transparent" BorderThickness="0" Padding="4"
                  Click="OnCreatorBlogClick"
                  ToolTipService.ToolTip="Creator blog">
            <TextBlock Text="&gt;_" Style="{StaticResource TerminalText}"
                       FontSize="13" FontWeight="Bold" Foreground="#00FF00" />
          </Button>
        </StackPanel>
      </StackPanel>
    </Grid>

    <Border Grid.Column="1" Background="#1A1A1A" />

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="20,16,20,0" Spacing="4">
        <TextBlock x:Name="ChatTitleBlock"
                   Text="&gt; direct chat"
                   Style="{StaticResource TerminalText}"
                   FontSize="14" Foreground="#00FF00" />
        <TextBlock Text="stateless request"
                   Style="{StaticResource TerminalText}"
                   FontSize="10" Foreground="#666666" />
        <Border Height="1" Background="#1A1A1A" Margin="0,8,0,0" />
      </StackPanel>

      <ScrollViewer x:Name="MessagesScroller" Grid.Row="1" Margin="20,8,20,0">
        <StackPanel x:Name="MessagesPanel" Spacing="12" />
      </ScrollViewer>

      <Grid x:Name="ChatInputArea" Grid.Row="2" Margin="20,8,20,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="MessageInput"
                   Style="{StaticResource TerminalInput}"
                   PlaceholderText="Type a message..."
                   KeyDown="OnMessageKeyDown"
                   TextChanged="OnMessageTextChanged"
                   TextWrapping="Wrap"
                   MaxHeight="120"
                   AcceptsReturn="False"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   HorizontalAlignment="Stretch" />
          <Button x:Name="SendButton"
                  Grid.Column="1"
                  Style="{StaticResource TerminalButton}"
                  Click="OnSendClick"
                  Margin="4,0,0,0">
            <TextBlock Text="send" Style="{StaticResource TerminalText}"
                       FontSize="13" Foreground="#00FF00" />
          </Button>
          <Button x:Name="CancelButton"
                  Grid.Column="2"
                  Style="{StaticResource TerminalButton}"
                  Click="OnCancelClick"
                  Visibility="Collapsed"
                  Margin="4,0,0,0"
                  ToolTipService.ToolTip="Cancel request">
            <TextBlock Text="stop" Style="{StaticResource TerminalText}"
                       FontSize="13" Foreground="#FF4444" />
          </Button>
        </Grid>
        <local:TerminalCursor x:Name="Cursor" Grid.Row="1" Margin="0,8,0,0" />
      </Grid>
    </Grid>
  </Grid>
</Page>
