<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Build-only tooling: central and project-local package policies use the same pins. -->
    <SharpClawMeziantouAnalyzerVersion>3.0.296</SharpClawMeziantouAnalyzerVersion>
    <SharpClawRoslynatorAnalyzersVersion>5.0.1</SharpClawRoslynatorAnalyzersVersion>
    <SharpClawThreadingAnalyzersVersion>18.7.23</SharpClawThreadingAnalyzersVersion>
    <SharpClawBannedApiAnalyzersVersion>5.6.0</SharpClawBannedApiAnalyzersVersion>
    <SharpClawPublicApiAnalyzersVersion>5.6.0</SharpClawPublicApiAnalyzersVersion>
    <SharpClawNUnitAnalyzersVersion>4.15.0</SharpClawNUnitAnalyzersVersion>
    <SharpClawHyperlinqAnalyzerVersion>2.3.0</SharpClawHyperlinqAnalyzerVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <Version>0.5.0-preview.1</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.1</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>

    <!--
      Adding NoWarn to remove build warnings
      NU1507: Warning when there are multiple package sources when using CPM with no source mapping
      NETSDK1201: Warning that specifying RID won't create self containing app
      PRI257: Ignore default language (en) not being one of the included resources (eg en-us, en-uk)
    -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257</NoWarn>
  </PropertyGroup>
</Project>
