# Administrator-controlled process overrides. dpkg preserves this conffile.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:48923
SHARPCLAW_INSTANCE_ROOT=/var/lib/sharpclaw/backend
SHARPCLAW_SHARED_ROOT=/var/lib/sharpclaw
SHARPCLAW_ENVIRONMENT_DIR=/var/lib/sharpclaw/backend/config
XDG_DATA_HOME=/var/lib/sharpclaw/user-data
Database__Provider=JsonFile
Auth__DisableApiKeyCheck=false
