# Loopback by default. Expose the Gateway only after configuring access/TLS.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:48924
SHARPCLAW_INSTANCE_ROOT=/var/lib/sharpclaw/gateway
SHARPCLAW_SHARED_ROOT=/var/lib/sharpclaw
SHARPCLAW_ENVIRONMENT_DIR=/var/lib/sharpclaw/gateway/config
XDG_DATA_HOME=/var/lib/sharpclaw/user-data
InternalApi__BaseUrl=http://127.0.0.1:48923
