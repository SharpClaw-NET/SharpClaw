#!/bin/sh
set -eu
attempt=0
while [ "$attempt" -lt 30 ]; do
    if curl --noproxy '*' --fail --silent --max-time 2 --output /dev/null http://127.0.0.1:48923/echo; then
        exit 0
    fi
    attempt=$((attempt + 1))
    sleep 1
done
echo 'SharpClaw Runtime did not become ready on its loopback endpoint.' >&2
exit 1
