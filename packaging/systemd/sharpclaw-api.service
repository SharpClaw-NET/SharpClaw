[Unit]
Description=SharpClaw API
Documentation=https://github.com/SharpClaw-NET/SharpClaw
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/usr/lib/sharpclaw/backend
ExecStart=/usr/lib/sharpclaw/backend/SharpClaw.Runtime.Host
ExecStartPost=/usr/lib/sharpclaw/wait-ready
TimeoutStartSec=100
TimeoutStopSec=90
Restart=on-failure
RestartSec=5
User=sharpclaw
Group=sharpclaw
EnvironmentFile=/etc/sharpclaw/runtime.env
UMask=0077

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sharpclaw

[Install]
WantedBy=multi-user.target
