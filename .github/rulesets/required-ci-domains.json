{
  "name": "Required CI Domains",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH",
        "refs/heads/release/**"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Correctness / Architecture Core Dependencies" },
          { "context": "Correctness / Architecture Module Dependencies" },
          { "context": "Correctness / Runtime Composition" },
          { "context": "Correctness / Gateway Boundaries" },
          { "context": "Correctness / Persistence Provider" },
          { "context": "Correctness / Persistence Environment" },
          { "context": "Correctness / Persistence Instances" },
          { "context": "Correctness / Providers" },
          { "context": "Correctness / LlamaSharp" },
          { "context": "Correctness / Durable Storage" },
          { "context": "Correctness / Direct Chat Kernel" },
          { "context": "Correctness / Production Module Graph" },
          { "context": "Correctness / Publishing" },
          { "context": "Correctness / CI Guardrails" }
        ]
      }
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": [
          "merge",
          "squash"
        ]
      }
    },
    {
      "type": "code_quality",
      "parameters": {
        "severity": "errors"
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {
            "tool": "CodeQL",
            "security_alerts_threshold": "medium_or_higher",
            "alerts_threshold": "errors"
          }
        ]
      }
    }
  ],
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ]
}
