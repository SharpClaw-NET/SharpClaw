<Project>
  <Target Name="_ResolvePackagedModulePayloadFiles">
    <PropertyGroup>
      <_SharpClawModulePayloadRoot Condition="'$(SharpClawModulePayloadRoot)' != ''">$([System.IO.Path]::GetFullPath('$(SharpClawModulePayloadRoot)'))</_SharpClawModulePayloadRoot>
    </PropertyGroup>

    <Error Condition="'$(_SharpClawModulePayloadRoot)' != '' and !Exists('$(_SharpClawModulePayloadRoot)\modules')"
           Text="SharpClawModulePayloadRoot must contain a modules directory." />

    <ItemGroup>
      <_PackagedModulePayloadFile Remove="@(_PackagedModulePayloadFile)" />
      <_PackagedSidecarHostFile Remove="@(_PackagedSidecarHostFile)" />

      <_PackagedModulePayloadFile Include="$(_SharpClawModulePayloadRoot)\modules\**\*"
                                  Condition="'$(_SharpClawModulePayloadRoot)' != ''" />

      <_PackagedSidecarHostFile Include="$(PkgSharpClaw_ModuleHost_OutOfProcess)\tools\$(TargetFramework)\any\SharpClaw.ModuleHost.OutOfProcess*"
                                Condition="'$(PkgSharpClaw_ModuleHost_OutOfProcess)' != ''" />
    </ItemGroup>
  </Target>
</Project>
