<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\build\PackagedContributionPayload.targets" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="LlamaSharp.ToolCallEnvelopes" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="Uno.UITest.Helpers" />
    <PackageReference Include="Xamarin.UITest" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="GitHubActionsTestLogger">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="Supprocom.Secrets" />
    <PackageReference Include="SharpClaw.Modules.EditorCommon" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.Modules.VS2026Editor" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.Modules.VSCodeEditor" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.AgentOrchestration.Contracts" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.Modules.Context" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.Modules.TwoTierPermission" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.Modules.Agents" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.Modules.Metrics" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.Modules.ModuleDev" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.SidecarHost.OutOfProcess" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.Modules.Providers.Anthropic" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.Modules.Providers.Google" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.Modules.Providers.LlamaSharp" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.Modules.Providers.Ollama" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.Modules.Providers.OpenAICompatible" GeneratePathProperty="true" ExcludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="SharpClaw.Providers.Common" />
    <PackageReference Include="SharpClaw.Providers.LocalCommon" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Fixtures\**\*.cs" />
    <Compile Remove="**\*.cs" />
    <Compile Include="GlobalUsings.cs" />
    <Compile Include="Architecture\**\*.cs" />
    <Compile Include="Gateway\**\*.cs" />
    <Compile Remove="Gateway\GatewayEndpointToggleTests.cs" />
    <Compile Include="Persistence\**\*.cs" />
    <Compile Remove="Persistence\EnvFileServiceTests.cs" />
    <Compile Include="Providers\**\*.cs" />
    <Compile Include="DurableStorage\**\*.cs" />
    <Compile Include="Publishing\**\*.cs" />
    <Compile Include="Ci\**\*.cs" />
    <Compile Include="Kernel\**\*.cs" />
    <Compile Include="Frontend\**\*.cs" />
    <Compile Include="ClientUno\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpClaw.Runtime\Host\SharpClaw.Runtime.Host.csproj" />
    <ProjectReference Include="..\SharpClaw.Client.Uno\SharpClaw.Client.Uno.csproj" />
    <ProjectReference Include="..\SharpClaw.Runtime\BLL\SharpClaw.Runtime.BLL.csproj" />
    <ProjectReference Include="..\SharpClaw.Runtime\INF\SharpClaw.Runtime.INF.csproj" />
    <ProjectReference Include="..\SharpClaw.Gateway\SharpClaw.Gateway.csproj" />
    <ProjectReference Include="..\SharpClaw.Shared\SharpClaw.Shared.csproj" />
    <ProjectReference Include="..\SharpClaw.DefaultModules\TestHarness.OutOfProcess\SharpClaw.DefaultModules.TestHarness.OutOfProcess.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\SharpClaw.DefaultModules\TestHarness.InProcess\SharpClaw.DefaultModules.TestHarness.InProcess.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Fixtures\ExternalModule\SharpClaw.TestFixtures.ExternalModule.csproj" />
    <ProjectReference Include="Fixtures\ForeignSidecar\SharpClaw.TestFixtures.ForeignSidecar.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyPackagedContributionsToTestOutput"
          AfterTargets="Build"
          DependsOnTargets="_ResolvePackagedContributionPayloadFiles">
    <ItemGroup>
      <_BundledRegistrationDll Include="$(ArtifactsPath)\bin\SharpClaw.DefaultModules.TestHarness.OutOfProcess\$(Configuration.ToLower())\SharpClaw.DefaultModules.TestHarness.OutOfProcess.dll"
                         Condition="'$(Configuration)' == 'Debug' and '$(ArtifactsPath)' != ''" />
      <_NonHostDll Include="$(ArtifactsPath)\bin\SharpClaw.DefaultModules.TestHarness.OutOfProcess\$(Configuration.ToLower())\*.dll"
                   Exclude="$(ArtifactsPath)\bin\SharpClaw.DefaultModules.TestHarness.OutOfProcess\$(Configuration.ToLower())\SharpClaw.*.dll"
                   Condition="'$(Configuration)' == 'Debug' and '$(ArtifactsPath)' != ''" />
      <_BundledRegistrationDll Include="$(MSBuildProjectDirectory)\..\SharpClaw.DefaultModules\TestHarness.*\bin\$(Configuration)\$(TargetFramework)\SharpClaw.DefaultModules.TestHarness.*.dll"
                         Condition="'$(ArtifactsPath)' == ''" />
      <_NonHostDll Include="$(MSBuildProjectDirectory)\..\SharpClaw.DefaultModules\TestHarness.*\bin\$(Configuration)\$(TargetFramework)\*.dll"
                   Exclude="$(MSBuildProjectDirectory)\..\SharpClaw.DefaultModules\TestHarness.*\bin\$(Configuration)\$(TargetFramework)\SharpClaw.*.dll"
                   Condition="'$(ArtifactsPath)' == ''" />
      <_BundledPackageManifest Include="$(MSBuildProjectDirectory)\..\SharpClaw.DefaultModules\TestHarness.OutOfProcess\package.json"
                              Condition="'$(Configuration)' == 'Debug'">
        <SourceId>sharpclaw_test_harness_out_of_process</SourceId>
      </_BundledPackageManifest>
      <_InProcessHarnessPayload Include="$(ArtifactsPath)\bin\SharpClaw.DefaultModules.TestHarness.InProcess\$(Configuration.ToLower())\SharpClaw.DefaultPackages.TestHarness.InProcess.dll"
                                Condition="'$(ArtifactsPath)' != ''" />
      <_InProcessHarnessPayload Include="$(ArtifactsPath)\bin\SharpClaw.DefaultModules.TestHarness.InProcess\$(Configuration.ToLower())\*.dll"
                                Exclude="$(ArtifactsPath)\bin\SharpClaw.DefaultModules.TestHarness.InProcess\$(Configuration.ToLower())\SharpClaw.*.dll"
                                Condition="'$(ArtifactsPath)' != ''" />
      <_InProcessHarnessPayload Include="$(MSBuildProjectDirectory)\..\SharpClaw.DefaultModules\TestHarness.InProcess\bin\$(Configuration)\$(TargetFramework)\SharpClaw.DefaultPackages.TestHarness.InProcess.dll"
                                Condition="'$(ArtifactsPath)' == ''" />
      <_InProcessHarnessPayload Include="$(MSBuildProjectDirectory)\..\SharpClaw.DefaultModules\TestHarness.InProcess\bin\$(Configuration)\$(TargetFramework)\*.dll"
                                Exclude="$(MSBuildProjectDirectory)\..\SharpClaw.DefaultModules\TestHarness.InProcess\bin\$(Configuration)\$(TargetFramework)\SharpClaw.*.dll" />
      <_InProcessHarnessManifest Include="$(MSBuildProjectDirectory)\..\SharpClaw.DefaultModules\TestHarness.InProcess\package.json" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)contributions\sharpclaw_test_harness;$(OutDir)contributions\sharpclaw_test_harness_in_process;$(OutDir)contributions\sharpclaw_test_harness_out_of_process" />
    <Copy SourceFiles="@(_BundledRegistrationDll);@(_NonHostDll)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_BundledRegistrationDll);@(_NonHostDll)' != ''" />
    <Copy SourceFiles="@(_InProcessHarnessPayload)"
          DestinationFolder="$(OutDir)test-contributions\sharpclaw_test_harness_in_process"
          SkipUnchangedFiles="true"
          Condition="'@(_InProcessHarnessPayload)' != ''" />
    <Copy SourceFiles="@(_InProcessHarnessManifest)"
          DestinationFiles="$(OutDir)test-contributions\sharpclaw_test_harness_in_process\package.json"
          SkipUnchangedFiles="true"
          Condition="'@(_InProcessHarnessManifest)' != ''" />
    <Copy SourceFiles="@(_PackagedSidecarHostFile)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(_PackagedSidecarHostFile)' != ''" />
    <Copy SourceFiles="@(_PackagedContributionPayloadFile)"
          DestinationFiles="@(_PackagedContributionPayloadFile->'$(OutDir)contributions\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_PackagedContributionPayloadFile)' != ''" />
    <Copy SourceFiles="@(_BundledPackageManifest)"
          DestinationFiles="@(_BundledPackageManifest->'$(OutDir)contributions\%(SourceId)\package.json')"
          SkipUnchangedFiles="true"
          Condition="'@(_BundledPackageManifest)' != ''" />
  </Target>
</Project>
