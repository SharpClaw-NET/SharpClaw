<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\PackagedContributionPayload.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupprocomSecretsTemplateDirectory>$(MSBuildThisFileDirectory)..\INF\Environment</SupprocomSecretsTemplateDirectory>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpClaw.Tests" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Supprocom.Secrets" />
    <PackageReference Include="SharpClaw.SidecarHost.InProcess" />
    <PackageReference Include="SharpClaw.SidecarHost.OutOfProcess" GeneratePathProperty="true" PrivateAssets="all" Publish="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BLL\SharpClaw.Runtime.BLL.csproj" />
    <PackageReference Include="SharpClaw.Contracts" />
    <ProjectReference Include="..\INF\SharpClaw.Runtime.INF.csproj" />
    <ProjectReference Include="..\..\SharpClaw.Shared\SharpClaw.Shared.csproj" />
  </ItemGroup>

  <Target Name="_ResolveBundledContributionOutputFiles"
          DependsOnTargets="_ResolvePackagedContributionPayloadFiles">
    <ItemGroup>
      <_BundledContributionOutputFile Remove="@(_BundledContributionOutputFile)" />
      <_BundledContributionOutputFile Include="@(_PackagedSidecarHostFile)" />
    </ItemGroup>
  </Target>

  <!-- Bind the SDK's RID-specific apphost to the reviewed package DLL, without
       rebuilding the sidecar or requiring a system-wide dotnet installation. -->
  <Target Name="CreateBundledSidecarAppHost" AfterTargets="CopyBundledContributions"
          DependsOnTargets="_GetAppHostPaths">
    <Error Condition="!Exists('$(AppHostSourcePath)')" Text="A target-platform apphost is required for the bundled sidecar." />
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(OutputPath)SharpClaw.SidecarHost.OutOfProcess$(_NativeExecutableExtension)"
                   AppBinaryName="SharpClaw.SidecarHost.OutOfProcess.dll"
                   IntermediateAssembly="$(OutputPath)SharpClaw.SidecarHost.OutOfProcess.dll"
                   EnableMacOSCodeSign="$(_EnableMacOSCodeSign)" />
    <Copy SourceFiles="$(PkgSharpClaw_SidecarHost_OutOfProcess)\tools\$(TargetFramework)\any\THIRD-PARTY-NOTICES.txt"
          DestinationFiles="$(OutputPath)SharpClaw.SidecarHost.THIRD-PARTY-NOTICES.txt" />
  </Target>

  <Target Name="CreatePublishedSidecarAppHost" AfterTargets="Publish"
          DependsOnTargets="CopyBundledContributionsToPublish;_GetAppHostPaths">
    <Error Condition="!Exists('$(AppHostSourcePath)')" Text="A target-platform apphost is required for the published sidecar." />
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)"
                   AppHostDestinationPath="$(PublishDir)SharpClaw.SidecarHost.OutOfProcess$(_NativeExecutableExtension)"
                   AppBinaryName="SharpClaw.SidecarHost.OutOfProcess.dll"
                   IntermediateAssembly="$(PublishDir)SharpClaw.SidecarHost.OutOfProcess.dll"
                   EnableMacOSCodeSign="$(_EnableMacOSCodeSign)" />
    <Copy SourceFiles="$(PublishDir)SharpClaw.Runtime.Host.runtimeconfig.json"
          DestinationFiles="$(PublishDir)SharpClaw.SidecarHost.OutOfProcess.runtimeconfig.json"
          Condition="'$(SelfContained)' == 'true'" />
    <!-- Both entry points use the SDK-generated local runtime/dependency
         closure. The framework-dependent tools deps file has no CoreCLR assets. -->
    <Copy SourceFiles="$(PublishDir)SharpClaw.Runtime.Host.deps.json"
          DestinationFiles="$(PublishDir)SharpClaw.SidecarHost.OutOfProcess.deps.json"
          Condition="'$(SelfContained)' == 'true'" />
    <Copy SourceFiles="$(PkgSharpClaw_SidecarHost_OutOfProcess)\tools\$(TargetFramework)\any\THIRD-PARTY-NOTICES.txt"
          DestinationFiles="$(PublishDir)SharpClaw.SidecarHost.THIRD-PARTY-NOTICES.txt" />
  </Target>

  <Target Name="CopyBundledContributions"
          AfterTargets="Build"
          DependsOnTargets="_ResolveBundledContributionOutputFiles">
    <Copy SourceFiles="@(_BundledContributionOutputFile)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PackagedContributionPayloadFile)"
          DestinationFiles="@(_PackagedContributionPayloadFile->'$(OutputPath)contributions\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_PackagedContributionPayloadFile)' != ''" />
  </Target>

  <Target Name="CopyBundledContributionsToPublish"
          AfterTargets="Publish"
          DependsOnTargets="_ResolveBundledContributionOutputFiles">
    <Copy SourceFiles="@(_BundledContributionOutputFile)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PackagedContributionPayloadFile)"
          DestinationFiles="@(_PackagedContributionPayloadFile->'$(PublishDir)contributions\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_PackagedContributionPayloadFile)' != ''" />
  </Target>

  <Target Name="CleanBundledContributions" AfterTargets="Clean">
    <ItemGroup>
      <_CopiedSidecarHostFile Include="$(OutputPath)SharpClaw.SidecarHost.OutOfProcess.*" />
      <_CopiedContributionFile Include="$(OutputPath)contributions\**\*" />
    </ItemGroup>
    <Delete Files="@(_CopiedSidecarHostFile)" Condition="'@(_CopiedSidecarHostFile)' != ''" />
    <Delete Files="@(_CopiedContributionFile)" Condition="'@(_CopiedContributionFile)' != ''" />
  </Target>

</Project>
