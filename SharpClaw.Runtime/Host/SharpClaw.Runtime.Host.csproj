<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\build\PackagedContributionPayload.targets" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupprocomSecretsTemplateDirectory>$(MSBuildThisFileDirectory)..\INF\Environment</SupprocomSecretsTemplateDirectory>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpClaw.Tests" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Supprocom.Secrets" />
    <PackageReference Include="SharpClaw.SidecarHost.InProcess" />
    <PackageReference Include="SharpClaw.SidecarHost.OutOfProcess" GeneratePathProperty="true" PrivateAssets="all" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BLL\SharpClaw.Runtime.BLL.csproj" />
    <PackageReference Include="SharpClaw.Contracts" />
    <ProjectReference Include="..\INF\SharpClaw.Runtime.INF.csproj" />
    <ProjectReference Include="..\..\SharpClaw.Shared\SharpClaw.Shared.csproj" />
    <ProjectReference Include="..\..\SharpClaw.Migrations\Postgres\SharpClaw.Migrations.Postgres.csproj" />
    <ProjectReference Include="..\..\SharpClaw.Migrations\SqlServer\SharpClaw.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\SharpClaw.Migrations\SQLite\SharpClaw.Migrations.SQLite.csproj" />
  </ItemGroup>

  <Target Name="_ResolveBundledContributionOutputFiles"
          DependsOnTargets="_ResolvePackagedContributionPayloadFiles">
    <ItemGroup>
      <_BundledContributionOutputFile Remove="@(_BundledContributionOutputFile)" />
      <_BundledContributionOutputFile Include="@(_PackagedSidecarHostFile)" />
    </ItemGroup>
  </Target>

  <Target Name="CopyBundledContributions"
          AfterTargets="Build"
          DependsOnTargets="_ResolveBundledContributionOutputFiles">
    <Copy SourceFiles="@(_BundledContributionOutputFile)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PackagedContributionPayloadFile)"
          DestinationFiles="@(_PackagedContributionPayloadFile->'$(OutputPath)contributions\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_PackagedContributionPayloadFile)' != ''" />
  </Target>

  <Target Name="CopyBundledContributionsToPublish"
          AfterTargets="Publish"
          DependsOnTargets="_ResolveBundledContributionOutputFiles">
    <Copy SourceFiles="@(_BundledContributionOutputFile)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PackagedContributionPayloadFile)"
          DestinationFiles="@(_PackagedContributionPayloadFile->'$(PublishDir)contributions\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_PackagedContributionPayloadFile)' != ''" />
  </Target>

  <Target Name="CleanBundledContributions" AfterTargets="Clean">
    <ItemGroup>
      <_CopiedSidecarHostFile Include="$(OutputPath)SharpClaw.SidecarHost.OutOfProcess.*" />
      <_CopiedContributionFile Include="$(OutputPath)contributions\**\*" />
    </ItemGroup>
    <Delete Files="@(_CopiedSidecarHostFile)" Condition="'@(_CopiedSidecarHostFile)' != ''" />
    <Delete Files="@(_CopiedContributionFile)" Condition="'@(_CopiedContributionFile)' != ''" />
  </Target>

</Project>
